# ================================================
# Online-Mirror v4.0 - URL 重写规则 (Apache)
# 启用方法：确保 mod_rewrite 已加载
# 使用方法：将本文件放在项目根目录
# 兼容 Apache 2.2 / 2.4+（旧版 Order/Deny 语法 + 新版 Require 语法）
# ================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ========== Clean URL 重写规则 (MVC) ==========

    # 首页
    RewriteRule ^$ index.php [L]

    # 捕获页: /capture/ID  →  capture.php?id=ID
    RewriteRule ^capture/save$ save.php [QSA,L]
    RewriteRule ^capture/([^/]+)$ capture.php?id=$1 [QSA,L]

    # 照片查看: /photos/ID  →  photos.php?id=ID
    RewriteRule ^photos/([^/]+)$ photos.php?id=$1 [QSA,L]

    # 管理后台: /admin  →  dashboard.php
    RewriteRule ^admin(/?)$ dashboard.php [QSA,L]

    # 登录/登出
    RewriteRule ^login$ login.php [L]
    RewriteRule ^logout$ login.php?action=logout [L]

    # 其他页面
    RewriteRule ^settings$ settings.php [QSA,L]
    RewriteRule ^install$ install.php [L]
    RewriteRule ^export$ export.php [QSA,L]

    # API 端点
    RewriteRule ^api/notify$ notify.php [L]
    RewriteRule ^api/photos$ ajax_photos.php [QSA,L]
    RewriteRule ^api/ai-analyze$ ajax_ai_analyze.php [L]

    # BUGFIX_LOG
    RewriteRule ^fixlog$ BUGFIX_LOG.md [L]
</IfModule>

# ========== 🔒 安全防护 ==========

# 禁止列出目录
Options -Indexes

# 禁止访问敏感文件（数据库、日志、备份、配置等）
# 兼容 Apache 2.4+ (Require) 与 Apache 2.2 (Order/Deny)
<FilesMatch "\.(sql|md|log|bak|old|backup|ini|sh|env|lock|git|svn)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# 禁止直接访问隐藏文件（.htaccess 本身、.git 等）
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# 禁止访问 PHP 备份/模板文件
<FilesMatch "\.(php\.bak|php\.old|phps|phtml|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
